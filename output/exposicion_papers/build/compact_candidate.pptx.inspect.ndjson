{"kind":"textbox","id":"sh/lgba58j6","slideIndex":3,"position":{"left":655,"top":270,"width":570,"height":108},"text":"Los expertos valoraron la descomposición. En 160 resultados iniciales hubo 44 errores: el reintento resolvió 18 y dejó 26.","geometry":"rect","lineWidth":0,"style":{"fontSize":24,"typeface":"Arial","color":"#142B3B","alignment":"left"}}
